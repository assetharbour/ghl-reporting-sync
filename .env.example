GHL_PRIVATE_TOKEN=your_ghl_private_token_here
GHL_LOCATION_ID=your_location_id_here
GHL_PIPELINE_ID=your_pipeline_id_here
GOOGLE_SHEET_ID=your_sheet_id_here
CRON_SECRET=generate_a_strong_random_string
GOOGLE_SERVICE_ACCOUNT_JSON=paste_full_service_account_json_here

# --- Evonex call write-back (all optional; the default is OFF) ---
# WRITEBACK_MODE=off            # off | dry_run | on
# WRITEBACK_TALK_SECONDS=60     # connected this long or more = Answered, shorter = Voicemail
# WRITEBACK_SETTLE_SECONDS=5
# WRITEBACK_MAX_AGE_MINUTES=120
# WRITEBACK_ADVISOR_NAMES=Henny Lessey,Joe Nicholls,Xavier Collin,Cecilia Szabo,Carl Gladman,Anthony Fox
# WRITEBACK_ADVISOR_STRICT=false

# --- Created By / Booked By locking, flags and the Appointments tab (optional; default OFF) ---
# FIELD_AUDIT=off               # off | on
# FIELD_AUDIT_SINCE=2026-11-01  # appointments booked earlier are never flagged
# APPOINTMENT_CALENDAR_IDS=Ms3bV1PlOqPVqjguHa6b
# BOOKED_BY_GRACE_HOURS=24
# TRUSTED_BOOKING_SOURCES=contactdetails_page
# SALES_TEAM_NAMES=Harry Kalsi,Ava Morris-Boundy,Hugo Sharpe

# Call evidence (needs FIELD_AUDIT=on and EVONEX_SHEET_ID). off = nothing runs.
# CALL_EVIDENCE=off
# CALL_MATCH_WINDOW_MINUTES=120
# CALL_CONVERSATION_SECONDS=60
# CALL_LONG_SECONDS=600
# BOOKER_OWNER_FLAG=off
